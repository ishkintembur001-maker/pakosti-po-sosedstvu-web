; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Пакости по соседству 3D"
run/main_scene="res://scenes/release_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

MobileShell="*res://scripts/mobile_shell.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

; Android exports require the ETC2/ASTC import pipeline even when Web uses GL compatibility.
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.mobile=1
lights_and_shadows/directional_shadow/size=1024
textures/default_filters/use_nearest_mipmap_filter=false

; Protect imported owner photo scan fidelity.
textures/default_filters/texture_mipmap_bias=-0.2
mesh_lod/lod_change/threshold_pixels=0.0
